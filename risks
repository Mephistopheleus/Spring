def get_risks_by_severity():
    """Возвращает риски по категориям критичности."""
    return {
        "HIGH": [r for r in RISKS if r["severity"] == "HIGH"],
        "MEDIUM": [r for r in RISKS if r["severity"] == "MEDIUM"],
        "LOW": [r for r in RISKS if r["severity"] == "LOW"],
    }


def get_risks_by_file():
    """Возвращает риски по файлам."""
    by_file = {}
    for risk in RISKS:
        file_ = risk["file"]
        if file_ not in by_file:
            by_file[file_] = []
        by_file[file_].append(risk)
    return by_file


def print_risks():
    """Выводит риски в консоль."""
    for severity in ["HIGH", "MEDIUM", "LOW"]:
        risks = get_risks_by_severity()[severity]
        if not risks:
            continue
        print(f"\n=== {severity} ===")
        for risk in risks:
            print(f"  [{risk['id']}] {risk['file']} — {risk['description'][:50]}...")


if __name__ == "__main__":
    print_risks()
